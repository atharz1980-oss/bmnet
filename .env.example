NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Meta Pixel — يُستخدم لتتبّع التحويلات /lp/mobile-content و/paths وما شابه (يُفعّل فقط إذا وُجد).
# يُفعّل = وجود Pixel ID في الواجهة. لا حاجة لتمكين عام ما لم تُضف معرف baytalmosawer.net.
NEXT_PUBLIC_META_PIXEL_ID=
# للتجربة: 1 لتمكين عرض أحداث Purchase افتراضية عبر حدث Pixel تجريبي.
META_PIXEL_TEST_PURCHASES=

# Nafath (نفاذ) - Identity verification integration (Saudi digital identity)
# Modes: disabled | sandbox | production
NAFATH_MODE=disabled
NAFATH_BASE_URL=
NAFATH_CLIENT_ID=
NAFATH_CLIENT_SECRET=
NAFATH_REDIRECT_URI=
NAFATH_SCOPE=openid profile
NAFATH_SESSION_TTL_MINUTES=10
