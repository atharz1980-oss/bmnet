# بيت المصور — نموذج متغيرات البيئة (CP-A)
# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية محليًا فقط — لا يُرفع أبدًا.

# Supabase — Project URL (من Settings > API في لوحة المشروع)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — Publishable (anon) Key — آمن للعميل بالتصميم (من Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — Secret (service_role) Key — لا يُستخدم في CP-A إطلاقًا
# (للاستخدام المستقبلي server-side فقط بعد اعتماد صريح — إيصاله للعميل كارثة أمنية)
SUPABASE_SECRET_KEY=
